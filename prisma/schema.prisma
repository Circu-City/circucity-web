// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SellerType {
  PRIVATE
  BUSINESS
}

model User {
  id    String @id // Configured to match Clerk User ID
  email String @unique
  role  Role   @default(BUYER)

  // User Profile
  name          String?
  image         String?
  ecoPoints     Int     @default(0)
  escrowBalance Int     @default(0)
  totalCo2Saved Float   @default(0.0)
  lastLoginDate DateTime?
  referredBy    String?

  // Billing & VAT
  stripeCustomerId String?  @map("stripe_customer_id")
  billingName      String?  @map("billing_name")
  billingAddress   String?  @map("billing_address")
  billingCity      String?  @map("billing_city")
  billingPostalCode String? @map("billing_postal_code")
  billingCountry   String?  @default("SE")  @map("billing_country")
  businessType     String?  @default("individual") @map("business_type")
  vatNumber        String?  @map("vat_number")
  vatValidated     Boolean? @default(false) @map("vat_validated")

  // Relations
  shop    Shop?
  orders  Order[]
  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]
  tickets       Ticket[]
  ticketReplies TicketReply[]
  wishlist      Wishlist?
  sellerFeedbacks SellerFeedback[]
  sentSwapProposals    SwapProposal[] @relation("SwapProposalSender")
  receivedSwapProposals SwapProposal[] @relation("SwapProposalRecipient")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String? // Optional link to related resource (e.g., /dashboard/orders/123)
  createdAt DateTime         @default(now())

  @@index([userId])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ORDER
  SWAP
}

model Shop {
  id            String  @id @default(cuid())
  name          String
  description   String?
  logo          String?
  coverImage    String?
  ecoPoints     Int     @default(0)
  totalCo2Saved Float   @default(0.0)

  sellerType         SellerType @default(PRIVATE)
  organizationNumber String?

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  products Product[]

  // PostNord Partner Integration
  postnordCustomerNumber String? // Each seller's PostNord customer number

  // Payout method fields
  bankName        String?
  accountHolder   String?
  clearingNumber  String?
  accountNumber   String?
  swiftIban       String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  productViews ProductView[]

  status  ShopStatus @default(PENDING)
  payouts Payout[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String           @id @default(cuid())
  name        String
  description String
  price       Decimal          @db.Decimal(10, 2)
  inventory   Int              @default(0)
  images      Json             @default("[]") // Array of image URLs
  status      ProductStatus    @default(ACTIVE)
  condition   ProductCondition @default(NEW)
  co2Saved    Float            @default(0.0)
  weight      Float? // Product weight in kg
  isFeatured  Boolean          @default(false)
  aiRawResponse       Json?
  aiSuggestedPriceSek Int?
  aiAnalyzedAt        DateTime?
  attributes          Json?

  // Relations
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  reviews    Review[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  views ProductView[]
  swapProposals SwapProposal[]

  moderationStatus ProductModerationStatus @default(APPROVED)
  wishlistItems    WishlistItem[]
}

model ProductView {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@index([productId])
  @@index([shopId])
  @@index([viewedAt])
}

model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  items  OrderItem[]
  total  Decimal     @db.Decimal(10, 2)
  status OrderStatus @default(PENDING)

  // Shipping Information
  shippingName         String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingState        String?
  shippingPostalCode   String?
  shippingCountry      String?

  // Cancellation & Refund Information
  cancelledAt        DateTime?
  cancellationReason String?
  refundId           String? // Stripe refund ID
  refundAmount       Decimal?  @db.Decimal(10, 2)
  stripeChargeId     String? // For tracking refunds
  processingFee      Decimal?  @db.Decimal(10, 2) // Legacy backend processing fee
  
  // Shield Fee & VAT Tracking
  feeGross           Decimal?  @db.Decimal(10, 2) // Total Shield Fee paid by buyer
  feeVat             Decimal?  @db.Decimal(10, 2) // VAT portion of the Shield Fee (20% of feeGross = 25% VAT rate)
  feeNet             Decimal?  @db.Decimal(10, 2) // CircuCity net revenue (Gross - Stripe)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shipments Shipment[]
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int
  price    Decimal @db.Decimal(10, 2) // Snapshot of price at purchase
}

model Review {
  id      String  @id @default(cuid())
  rating  Int     @default(5)
  comment String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
  SOLD
}

enum ProductCondition {
  NEW
  LIKE_NEW
  REFURBISHED
  GOOD
  FAIR
  POOR
}

model Shipment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  // PostNord Tracking Information
  trackingNumber String  @unique
  carrier        String  @default("PostNord")
  serviceType    String? // e.g., "MyPack Home", "Parcel", etc.

  // Shipment Details
  status            ShipmentStatus @default(PENDING)
  estimatedDelivery DateTime?
  actualDelivery    DateTime?

  // Sender Information (Shop/Warehouse)
  senderName       String?
  senderAddress    String?
  senderCity       String?
  senderPostalCode String?
  senderCountry    String?

  // Recipient Information (from Order)
  recipientName       String
  recipientAddress    String
  recipientCity       String
  recipientPostalCode String
  recipientCountry    String

  // Package Details
  weight Float? // in kg
  length Float? // in cm
  width  Float? // in cm
  height Float? // in cm

  // Carrier-specific IDs
  postnordShipmentId  String? // PostNord's internal ID
  shipmondoShipmentId String? // Shipmondo's internal ID/label ID
  labelUrl            String? // URL to shipping label PDF

  // Tracking Events
  trackingEvents TrackingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  status      String // e.g., "In Transit", "Out for Delivery", "Delivered"
  description String? // Detailed description of the event
  location    String? // Location where event occurred
  timestamp   DateTime

  createdAt DateTime @default(now())
}

enum ShipmentStatus {
  PENDING // Shipment created but not yet picked up
  PICKED_UP // Package picked up by carrier
  IN_TRANSIT // Package in transit
  OUT_FOR_DELIVERY // Out for delivery
  DELIVERED // Successfully delivered
  FAILED_DELIVERY // Delivery attempt failed
  RETURNED // Returned to sender
  CANCELLED // Shipment cancelled
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProductModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Payout {
  id          String       @id @default(cuid())
  shopId      String
  shop        Shop         @relation(fields: [shopId], references: [id])
  amount      Decimal      @db.Decimal(10, 2)
  status      PayoutStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  processedAt DateTime?
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Ticket {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  subject   String
  message   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  replies   TicketReply[]
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String
  details     String?
  performedBy String
  createdAt   DateTime @default(now())
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id])
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())
}

model SwapProposal {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  swapProductId   String?
  swapProductName String?
  fromUserId   String
  fromUser     User     @relation("SwapProposalSender", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User     @relation("SwapProposalRecipient", fields: [toUserId], references: [id])
  amount       Int
  message      String?
  trackingInfo     String?
  sellerAShipped   Boolean  @default(false)
  sellerBShipped   Boolean  @default(false)
  sellerATracking  String?
  sellerBTracking  String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  completedAt      DateTime?
  inspectionEndsAt DateTime?
  disputeReason    String?
  disputeEvidence  String?  @db.Text
  disputeResolvedBy String?
  swapCompletedAt  DateTime?

  @@index([toUserId, status])
  @@index([fromUserId])
}

model SellerFeedback {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  feedbackType  String   // 'problem' or 'feature'
  frictionPoint String?  // e.g., 'low-visibility', 'weak-analytics'
  satisfaction  Json?    // e.g., { listing: 3, shipping: 2, payouts: 1 }
  comment       String?  @db.Text
  isRead        Boolean  @default(false)
  
  createdAt     DateTime @default(now())
}

model PlatformSettings {
  id        String   @id @default(cuid())
  section   String
  key       String
  value     String?  @db.Text
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([section, key], name: "section_key")
  @@index([section], name: "section_idx")
  @@map("PlatformSettings")
}

