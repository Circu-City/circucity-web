generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String           @id
  email                 String           @unique
  role                  Role             @default(BUYER)
  name                  String?
  image                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  ecoPoints             Int              @default(0)
  escrowBalance         Int              @default(0)
  totalCo2Saved         Float            @default(0)
  lastLoginDate         DateTime?
  referredBy            String?
  lastShareDate         DateTime?        @db.DateTime(0)
  stripeCustomerId      String?          @map("stripe_customer_id") @db.VarChar(255)
  billingName           String?          @map("billing_name") @db.VarChar(255)
  billingAddress        String?          @map("billing_address") @db.VarChar(255)
  billingCity           String?          @map("billing_city") @db.VarChar(255)
  billingPostalCode     String?          @map("billing_postal_code") @db.VarChar(20)
  billingCountry        String?          @default("SE") @map("billing_country") @db.VarChar(2)
  businessType          String?          @default("individual") @map("business_type") @db.VarChar(20)
  vatNumber             String?          @map("vat_number") @db.VarChar(50)
  vatValidated          Int?             @default(0) @map("vat_validated") @db.TinyInt
  notifications         Notification[]
  orders                Order[]
  reviews               Review[]
  sellerFeedbacks       SellerFeedback[]
  shop                  Shop?
  shopFollows              ShopFollow[]
  sentSwapProposals     SwapProposal[]   @relation("SwapProposalSender")
  receivedSwapProposals SwapProposal[]   @relation("SwapProposalRecipient")
  tickets               Ticket[]
  ticketReplies         TicketReply[]
  wishlist              Wishlist?
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Shop {
  id                           String                   @id @default(cuid())
  name                         String
  description                  String?
  logo                         String?
  coverImage                   String?
  ownerId                      String                   @unique
  postnordCustomerNumber       String?
  bankName                     String?                  @db.VarChar(255)
  accountHolder                String?                  @db.VarChar(255)
  clearingNumber               String?                  @db.VarChar(50)
  accountNumber                String?                  @db.VarChar(100)
  swiftIban                    String?                  @db.VarChar(100)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  status                       ShopStatus               @default(PENDING)
  ecoPoints                    Int                      @default(0)
  totalCo2Saved                Float                    @default(0)
  organizationNumber           String?
  sellerType                   SellerType               @default(PRIVATE)
  legalName                    String?
  website                      String?
  address                      String?
  postalCode                   String?
  city                         String?
  categoryFocus                Json?
  returnPolicy                 String?                  @db.Text
  verified                     Boolean                  @default(false)
  verifiedAt                   DateTime?
  verificationStatus           ShopVerificationStatus  @default(NOT_STARTED)
  verificationMethod           ShopVerificationMethod?
  verificationSubmittedAt      DateTime?
  verificationReviewedAt       DateTime?
  verificationReviewedBy       String?
  verificationRejectionReason  String?                  @db.Text
  businessRegistrationVerified Boolean                  @default(false)
  addressVerified              Boolean                  @default(false)
  managerIdentityVerified      Boolean                  @default(false)
  returnPolicyApproved         Boolean                  @default(false)
  payouts                      Payout[]
  products                     Product[]
  productViews                 ProductView[]
  owner                        User                     @relation(fields: [ownerId], references: [id])
  followers                     ShopFollow[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id                  String                  @id @default(cuid())
  name                String
  description         String
  price               Decimal                 @db.Decimal(10, 2)
  inventory           Int                     @default(0)
  images              Json
  status              ProductStatus          @default(ACTIVE)
  condition           ProductCondition        @default(NEW)
  co2Saved            Float                   @default(0)
  weight              Float?
  isFeatured          Boolean                 @default(false)
  shopId              String
  categoryId          String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  moderationStatus    ProductModerationStatus @default(APPROVED)
  aiRawResponse       Json?
  aiSuggestedPriceSek Int?
  aiAnalyzedAt        DateTime?
  attributes          Json?
  orderItems          OrderItem[]
  category            Category                @relation(fields: [categoryId], references: [id])
  shop                Shop                    @relation(fields: [shopId], references: [id])
  views               ProductView[]
  reviews             Review[]
  wishlistItems       WishlistItem[]

  swapProposals       SwapProposal[]

  @@index([categoryId], map: "Product_categoryId_fkey")
  @@index([shopId], map: "Product_shopId_fkey")
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
  shopId    String
  viewedAt  DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([shopId])
  @@index([viewedAt])
}

model Order {
  id                   String      @id @default(cuid())
  userId               String
  total                Decimal     @db.Decimal(10, 2)
  status               OrderStatus @default(PENDING)
  shippingName         String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingState        String?
  shippingPostalCode   String?
  shippingCountry      String?
  cancelledAt          DateTime?
  cancellationReason   String?
  refundId             String?
  refundAmount         Decimal?    @db.Decimal(10, 2)
  stripeChargeId       String?
  processingFee        Decimal?    @db.Decimal(10, 2)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  feeGross             Decimal?    @db.Decimal(10, 2)
  feeNet               Decimal?    @db.Decimal(10, 2)
  feeVat               Decimal?    @db.Decimal(10, 2)
  user                 User        @relation(fields: [userId], references: [id])
  items                OrderItem[]
  shipments            Shipment[]

  @@index([userId], map: "Order_userId_fkey")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  co2Saved  Float   @default(0)
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  comment   String?
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([productId], map: "Review_productId_fkey")
  @@index([userId], map: "Review_userId_fkey")
}

model Shipment {
  id                  String          @id @default(cuid())
  orderId             String
  trackingNumber      String          @unique
  carrier             String          @default("PostNord")
  serviceType         String?
  status              ShipmentStatus  @default(PENDING)
  estimatedDelivery   DateTime?
  actualDelivery      DateTime?
  senderName          String?
  senderAddress       String?
  senderCity          String?
  senderPostalCode    String?
  senderCountry       String?
  recipientName       String
  recipientAddress    String
  recipientCity       String
  recipientPostalCode String
  recipientCountry    String
  weight              Float?
  length              Float?
  width               Float?
  height              Float?
  postnordShipmentId  String?
  labelUrl            String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  shipmondoShipmentId String?         @db.VarChar(255)
  order               Order           @relation(fields: [orderId], references: [id])
  trackingEvents      TrackingEvent[]

  @@index([orderId], map: "Shipment_orderId_fkey")
}

model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  status      String
  description String?
  location    String?
  timestamp   DateTime
  createdAt   DateTime @default(now())
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId], map: "TrackingEvent_shipmentId_fkey")
}

model Payout {
  id          String       @id @default(cuid())
  shopId      String
  amount      Decimal      @db.Decimal(10, 2)
  status      PayoutStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  processedAt DateTime?
  shop        Shop         @relation(fields: [shopId], references: [id])

  @@index([shopId], map: "Payout_shopId_fkey")
}

model Ticket {
  id        String         @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id])
  replies   TicketReply[]

  @@index([userId], map: "Ticket_userId_fkey")
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  message   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([ticketId], map: "TicketReply_ticketId_fkey")
  @@index([userId], map: "TicketReply_userId_fkey")
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String
  details     String?
  performedBy String
  createdAt   DateTime @default(now())
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id])
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id])

  @@unique([wishlistId, productId])
  @@index([productId], map: "WishlistItem_productId_fkey")
}

model SwapProposal {
  id                String    @id @default(cuid())
  productId         String
  swapProductId     String?
  swapProductName   String?   @db.VarChar(255)
  fromUserId        String
  toUserId          String
  amount            Int
  message           String?   @db.Text
  trackingInfo      String?   @db.VarChar(500)
  sellerAShipped    Boolean   @default(false)
  sellerBShipped    Boolean   @default(false)
  sellerATracking   String?   @db.VarChar(500)
  sellerBTracking   String?   @db.VarChar(500)
  status            String    @default("pending")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  completedAt       DateTime?
  inspectionEndsAt  DateTime?
  disputeReason     String?   @db.VarChar(500)
  disputeEvidence   String?   @db.Text
  disputeResolvedBy String?
  swapCompletedAt   DateTime?
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromUser          User      @relation("SwapProposalSender", fields: [fromUserId], references: [id])
  toUser            User      @relation("SwapProposalRecipient", fields: [toUserId], references: [id])

  @@index([fromUserId], map: "idx_fromUserId")
  @@index([toUserId, status], map: "idx_toUserId_status")
}

model SellerFeedback {
  id            String   @id @default(cuid())
  userId        String
  feedbackType  String
  frictionPoint String?
  satisfaction  Json?
  comment       String?  @db.Text
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "SellerFeedback_userId_fkey")
}

model PlatformSettings {
  id        String    @id @default(cuid()) @db.VarChar(36)
  section   String    @db.VarChar(100)
  key       String    @db.VarChar(100)
  value     String?   @db.Text
  updatedBy String?   @db.VarChar(36)
  createdAt DateTime? @default(now()) @db.DateTime(0)
  updatedAt DateTime? @default(now()) @updatedAt @db.DateTime(0)

  @@unique([section, key], name: "section_key", map: "section_key")
  @@index([section], map: "section_idx")
  @@map("PlatformSettings")
}

/// A short-lived hold on stock taken while a buyer is at the Stripe payment page.
/// Availability is `Product.inventory` minus the sum of ACTIVE, unexpired rows here.
/// Deliberately not a Prisma relation to Product: nothing needs to traverse it, and
/// keeping it standalone avoids adding cascade behaviour to product deletion.
model CheckoutReservation {
  id            String   @id @default(cuid())
  /// Groups every line of one checkout; also written to Stripe session metadata.
  reservationId String
  productId     String
  quantity      Int
  /// ACTIVE | CONSUMED (payment completed) | RELEASED (session expired or failed)
  status        String   @default("ACTIVE")
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId, status, expiresAt])
  @@index([reservationId])
}

model ShopFollow {
  id        String   @id @default(cuid())
  userId    String
  shopId    String
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([shopId])
}

model chat_history {
  id           Int       @id @default(autoincrement())
  session_id   String    @db.VarChar(128)
  workspace_id String?
  role         String    @db.VarChar(20)
  content      String    @db.Text
  created_at   DateTime? @default(now()) @db.Timestamp(0)

  @@index([session_id], map: "idx_chat_history_session")
  @@index([workspace_id], map: "idx_workspace")
}

model invoices {
  id                     Int       @id @default(autoincrement())
  tenant_id              String    @db.VarChar(255)
  stripe_invoice_id      String?   @db.VarChar(255)
  stripe_subscription_id String?   @db.VarChar(255)
  amount                 Decimal?  @db.Decimal(10, 2)
  currency               String?   @default("sek") @db.VarChar(3)
  status                 String?   @db.VarChar(50)
  invoice_url            String?   @db.Text
  paid_at                DateTime? @db.DateTime(0)
  created_at             DateTime? @default(now()) @db.DateTime(0)
}

model subscription_plans {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)
  price_monthly   Decimal?  @default(0.00) @db.Decimal(10, 2)
  price_yearly    Decimal?  @default(0.00) @db.Decimal(10, 2)
  stripe_price_id String?   @db.VarChar(255)
  max_documents   Int?      @default(10)
  max_crawl_pages Int?      @default(50)
  features        Json?
  is_active       Boolean?  @default(true)
  created_at      DateTime? @default(now()) @db.DateTime(0)
}

model tenant_allowed_origins {
  id        Int    @id @default(autoincrement())
  tenant_id String
  origin    String @db.VarChar(500)

  @@index([tenant_id], map: "tenant_id")
}

model tenants {
  tenant_id        String    @id
  name             String    @db.VarChar(255)
  theme_color      String?   @default("#1e3a2f") @db.VarChar(50)
  welcome_message  String?   @db.Text
  widget_enabled   Boolean?  @default(true)
  api_key_required Boolean?  @default(false)
  widget_api_key   String?   @db.VarChar(255)
  owner_user_id    String?
  created_at       DateTime? @default(now()) @db.Timestamp(0)
}

model workspace_payment_methods {
  id                       Int       @id @default(autoincrement())
  tenant_id                String    @db.VarChar(255)
  stripe_payment_method_id String?   @db.VarChar(255)
  stripe_customer_id       String?   @db.VarChar(255)
  pm_type                  String?   @db.VarChar(50)
  last4                    String?   @db.VarChar(10)
  brand                    String?   @db.VarChar(50)
  exp_month                Int?
  exp_year                 Int?
  is_default               Boolean?  @default(false)
  created_at               DateTime? @default(now()) @db.DateTime(0)
}

model workspace_subscriptions {
  id                     Int       @id @default(autoincrement())
  tenant_id              String    @db.VarChar(255)
  plan_id                Int?
  stripe_subscription_id String?   @db.VarChar(255)
  stripe_customer_id     String?   @db.VarChar(255)
  status                 String?   @default("free") @db.VarChar(50)
  current_period_start   DateTime? @db.DateTime(0)
  current_period_end     DateTime? @db.DateTime(0)
  created_at             DateTime? @default(now()) @db.DateTime(0)
  updated_at             DateTime? @default(now()) @db.DateTime(0)

  @@index([plan_id], map: "plan_id")
}

model workspaces {
  id            String   @id
  name          String   @db.VarChar(255)
  api_key       String   @unique(map: "api_key") @db.VarChar(255)
  owner_user_id String
  website_url   String?  @db.VarChar(500)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SellerType {
  PRIVATE
  BUSINESS
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ORDER
  SWAP
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum ProductCondition {
  NEW
  LIKE_NEW
  REFURBISHED
  GOOD
  FAIR
  POOR
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELLED
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProductModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
  SOLD
  ARCHIVED
}

enum ShopVerificationStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum ShopVerificationMethod {
  BANKID
  MANUAL
  CHARITY_REG
}
